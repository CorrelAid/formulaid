# OpenRouter API key for agent optimization (used by scripts/initialize_agents.ts)
OPENROUTER_API_KEY=

# Optional: GitHub personal access token to avoid API rate limits during build
# (unauthenticated requests are capped at 60/hour)
GITHUB_TOKEN=

# Optional: qwacback MCP server endpoint (defaults to https://qwacback.correlaid.org/mcp)
QWACBACK_MCP_URL=
# Optional: Bearer token for qwacback MCP authentication
QWACBACK_MCP_TOKEN=
